# Copy to .env.local (same folder) and fill in. Server-only — never prefix with NEXT_PUBLIC_,
# never commit .env.local. Next.js reloads it in dev; restart `npm run dev` if it doesn't.

# --- Option A (default): Gemma 4 through the Gemini API -----------------------
# Key from Google AI Studio (https://aistudio.google.com/apikey).
# GEMMA_API_KEY is accepted as an alias for the same key.
GEMINI_API_KEY=
# gemma-4-26b-a4b-it (default: fast MoE, ~10-30 s per sketch) or gemma-4-31b-it (dense).
VISION_MODEL=gemma-4-26b-a4b-it
# Tried automatically when the model above is overloaded (429/500/503). Defaults to the
# other Gemma 4 model; set to "off" to disable.
VISION_FALLBACK_MODEL=
# Optional: "on" lets Gemma 4 think before answering (slower, sometimes more accurate).
VISION_THINKING=

# --- Option B: any OpenAI-compatible chat completions endpoint ----------------
# Used only when GEMINI_API_KEY is empty. VISION_MODEL above must then name that
# server's model, e.g. Ollama: VISION_API_URL=http://localhost:11434/v1/chat/completions
VISION_API_URL=
VISION_API_KEY=
